{
  "name": "refugio-mobile",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "kiosk": "yarn workspace kiosk start",
