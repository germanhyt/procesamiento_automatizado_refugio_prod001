{
  "expo": {
    "name": "runner",
    "slug": "runner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-refugio.png",
    "scheme": "runner",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/logo-refugio.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "minSdkVersion": 23,
      "targetSdkVersion": 33,
      "compileSdkVersion": 33,
      "usesCleartextTraffic": true,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo-refugio.png",
        "backgroundImage": "./assets/images/logo-refugio.png",
        "monochromeImage": "./assets/images/logo-refugio.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.refugdata.runner"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo-refugio.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo-refugio.png",
          "color": "#00cc99",
          "defaultChannel": "delivery-runner"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "63c062ba-a50c-4716-a275-9faf8f0b412d"
      }
    },
    "owner": "refugdata"
  }
}
