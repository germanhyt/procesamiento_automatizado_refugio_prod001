# Copiar a `.env`. Solo afecta a Metro / Expo Go / `yarn kiosk` (no a builds EAS).

# Elige UNA pareja de URLs. FastAPI debe escuchar en 0.0.0.0:8080 (ver backend/main.py).

# --- A) Emulador Android (AVD) — "localhost" del host es 10.0.2.2 ---
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
EXPO_PUBLIC_WS_URL=ws://10.0.2.2:8080

# --- B) Dispositivo físico / SUNMI (misma Wi‑Fi que tu PC; cambia la IP) ---
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8080
# EXPO_PUBLIC_WS_URL=ws://192.168.1.50:8080

# --- C) Producción (solo referencia; builds firmados suelen usar eas.json) ---
# EXPO_PUBLIC_API_URL=https://api.datarefugio.gcbprojects.site
# EXPO_PUBLIC_WS_URL=wss://api.datarefugio.gcbprojects.site
